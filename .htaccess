# ==============================================================
# SHARE MARKET EXPERT ADMIN — HOSTINGER APACHE / LITESPEED SECURITY
# ==============================================================

DirectoryIndex index.html

Options -Indexes

# Block sensitive config and database files
<FilesMatch "^(\.env.*|schema\.sql|.*\.sql|.*\.log|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to config folder directly
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/ - [F,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

